{
	"name": "territory",
	"version": "0.77.0",
	"private": true,
	"description": "A deterministic, WebGPU-rendered pixel territory war.",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.28.5",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:fast": "vitest run --project fast",
		"test:worker": "node scripts/worker-smoke.cjs",
		"test:stress": "vitest run --project stress",
		"check:boundaries": "tsx scripts/check-import-boundaries.ts",
		"bench": "tsx scripts/benchmark.ts",
		"bench:online": "tsx scripts/online-load.ts",
		"telemetry": "tsx scripts/telemetry.ts",
		"balance": "tsx scripts/balance-sweep.ts",
		"soak": "tsx scripts/soak.ts",
		"evolution": "tsx scripts/evolution.ts",
		"ai:balance": "tsx scripts/ai-balance.ts",
		"docs:reference": "tsx scripts/docs-reference.ts --write",
		"docs:check": "tsx scripts/docs-reference.ts --check",
		"test:watch": "vitest --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24",
		"@webgpu/types": "^0.1.74",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"spacetimedb": "2.16.1"
	}
}
